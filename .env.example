# Local dev: values printed by `supabase start` / `supabase status`
# Production: from your hosted Supabase project's API settings
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional: enables Haiku link-metadata enrichment in /api/unfurl.
# Absent → enrichment is skipped and the raw unfurl is used as-is.
ANTHROPIC_API_KEY=
# Used only by scripts/seed-users.ts — never imported by app code (keep out of prod)
SUPABASE_SERVICE_ROLE_KEY=
# Google sign-in (local stack only): an OAuth client from Google Cloud Console with
# http://127.0.0.1:54321/auth/v1/callback as an authorized redirect URI. In production
# these live in Supabase Auth → Providers → Google, not here.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
